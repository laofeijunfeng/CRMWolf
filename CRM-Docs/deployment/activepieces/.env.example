# Keep the image pinned; upgrade deliberately and re-run the MVP acceptance checks.
AP_VERSION=0.90.4
ACTIVEPIECES_BIND_ADDRESS=127.0.0.1
ACTIVEPIECES_PORT=8080

# AP_ENCRYPTION_KEY must be exactly 32 hexadecimal characters (16 bytes).
# Generate: openssl rand -hex 16
AP_ENCRYPTION_KEY=replace-with-openssl-rand-hex-16
AP_JWT_SECRET=replace-with-a-long-random-secret
AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://localhost:8080

AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=replace-with-a-database-password

# Shared CRM Redis service. CRM uses DB 5; Activepieces uses DB 6.
AP_REDIS_HOST=redis6
AP_REDIS_PORT=6379
AP_REDIS_DB=6
AP_REDIS_PASSWORD=

AP_EXECUTION_MODE=UNSANDBOXED
AP_TELEMETRY_ENABLED=false
